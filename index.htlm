<!doctype html>
<html lang="es"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<meta name="mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"><meta name="theme-color" content="#f2f2f7">
<title>Notas</title>
<style>
@font-face{font-family:"InterE";font-weight:400;font-style:normal;font-display:swap;src:url(data:font/woff;base64,) format("woff")}
@font-face{font-family:"InterE";font-weight:600;font-style:normal;font-display:swap;src:url(data:font/woff;base64,) format("woff")}
@font-face{font-family:"InterE";font-weight:700;font-style:normal;font-display:swap;src:url(data:font/woff;base64,) format("woff")}

:root{--bg:#f3efe6;--fg:#1d1c1a;--card:#fff;--gold:#c8962e;--mut:#6b675e;box-sizing:border-box}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#1c1c1e;--fg:#f2efe6;--card:#2a2a2d;--gold:#e0b44f;--mut:#a09b90}}
:root[data-theme="dark"]{--bg:#1c1c1e;--fg:#f2efe6;--card:#2a2a2d;--gold:#e0b44f;--mut:#a09b90}
html,body{height:100%;margin:0}
body{background:var(--bg);color:var(--fg);font-family:"Helvetica Neue",Arial,sans-serif;display:flex;justify-content:center;-webkit-user-select:none;user-select:none}
#app{width:100%;max-width:420px;height:100%;position:relative;overflow:hidden}
.pg{height:100%;overflow-y:auto;padding:22px 20px;box-sizing:border-box}
h1{font-size:22px;text-align:center;margin:40px 0 28px}h2{font-size:15px;color:var(--gold);margin:22px 0 8px;letter-spacing:.04em;text-transform:uppercase}
p{font-size:14px;line-height:1.5;margin:0 0 10px}
.btn{display:block;width:100%;background:var(--gold);color:#1c1c1e;border:0;border-radius:4px;padding:12px;font-weight:700;font-size:13px;margin:0 0 14px;cursor:pointer}
.btn.s{background:var(--card);color:var(--fg);border:1px solid var(--mut)}
.top{display:flex;align-items:center;gap:10px;margin-bottom:12px}.top b{flex:1}
.back{background:none;border:0;color:var(--gold);font-size:22px;cursor:pointer;padding:4px 8px}
select,input[type=text],textarea{width:100%;box-sizing:border-box;background:var(--card);color:var(--fg);border:1px solid var(--mut);border-radius:4px;padding:9px;font:inherit;font-size:14px;margin-bottom:10px;-webkit-user-select:text;user-select:text}
textarea{min-height:120px}
.row{display:flex;justify-content:space-between;align-items:center;background:var(--card);padding:12px;border-radius:4px;margin-bottom:8px;font-size:14px;cursor:pointer}
.sw{display:inline-block;width:56px;height:100px;border-radius:10px;margin:0 8px 8px 0;background-size:cover;border:2px solid transparent;cursor:pointer}.sw.on{border-color:var(--gold)}
/* Notas */
.notes{position:absolute;inset:0;background:#f2f2f7;color:#000;overflow-y:auto;touch-action:pan-y;display:flex;flex-direction:column;font-family:-apple-system,"SF Pro Text","InterE","Inter","Helvetica Neue",Arial,sans-serif;-webkit-font-smoothing:antialiased;letter-spacing:-.011em}
.notes>*{flex:none}
.notes.d{background:#fff}
.ntop{padding:24px 15px 6px;display:flex;justify-content:space-between;align-items:center;color:#e5a50a;font-size:17px;position:sticky;top:0;z-index:2;background:#fffffff2;-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px)}
.ntop.g{background:linear-gradient(#f2f2f7 75%,#f2f2f700);-webkit-backdrop-filter:none;backdrop-filter:none}
.bk{display:flex;align-items:center;gap:9px;background:none;border:0;color:inherit;font:inherit;padding:0 0 0 8px;cursor:pointer}
.rt{display:flex;gap:12px;align-items:center}.d .rt{gap:30px;padding-right:2px}.d .rt svg:last-child{width:23px;height:23px}
.gl{min-width:45px;height:45px;border-radius:23px;background:#fff;box-shadow:0 0 0 .5px #0000000d,0 2px 9px #0000001f;display:flex;align-items:center;justify-content:center;color:#000;border:0;font:inherit;font-size:17px;padding:0 12px;cursor:pointer}
.gl.p{padding:0 19px}
.big{font-size:36px;font-weight:700;line-height:1.1;margin:6px 16px 10px;letter-spacing:.2px}
.sec,.hd{margin:22px 16px 8px;font-size:20px;font-weight:700;display:flex;justify-content:space-between;align-items:center}
.hd svg{margin-right:8px}
.grp{margin:0 16px 8px;background:#fff;border-radius:26px;overflow:hidden}
.fr{display:flex;align-items:center;padding-left:14px;cursor:pointer}
.fr i{width:27px;display:flex;justify-content:center;font-style:normal;margin-right:15px}.fr i svg{width:27px;height:auto}
.fx{flex:1;display:flex;align-items:center;height:52px;margin-right:16px;gap:10px;font-size:17px}.fr+.fr .fx{border-top:.5px solid #d9d9de}
.fx span{flex:1}.fx em{font-style:normal;color:#8e8e93}.fx u{display:flex}
.sq{width:27px;height:27px;border-radius:7px;display:flex;align-items:center;justify-content:center}.sq svg{width:17px;height:auto}
.nr{position:relative;padding:12px 20px;cursor:pointer}.nr+.nr::before{content:"";position:absolute;top:0;left:20px;right:0;border-top:.5px solid #d9d9de}.nr:active,.fr:active{background:#e9e9ee}
.nr b{display:block;font-size:17px;font-weight:600}
.nr small{color:#8e8e93;font-size:15px;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.35}
.nr em{font-style:normal;color:#3c3c43;margin-right:8px;font-variant-numeric:tabular-nums}.nr .fl{font-size:13px}
.fb{position:sticky;bottom:0;margin-top:auto;display:flex;gap:11px;padding:10px 27px 22px;background:#f2f2f7d9;-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);border-top:.5px solid #d4d4d9}
.sp{flex:1;height:48px;border-radius:24px;background:#fff;display:flex;align-items:center;gap:8px;padding:0 19px 0 15px;color:#8e8e93;font-size:17px;box-shadow:0 0 0 .5px #0000000d,0 2px 9px #0000001a}.sp span{flex:1;padding-left:5px}.sp svg:first-child{color:#000}
.cp{width:49px;height:49px;border-radius:50%;background:#fff;border:0;box-shadow:0 0 0 .5px #0000000d,0 2px 9px #0000001a;color:#000;display:flex;align-items:center;justify-content:center;cursor:pointer}
.it{padding:0 24px;font-size:17px;line-height:25px;color:#3c3c3e;display:flex}.it i{font-style:normal;min-width:30px}
.it.t{font-size:32px;font-weight:700;line-height:38px;color:#3d3d3f;margin:20px 0 25px;display:block}
.nb{position:sticky;bottom:0;margin-top:auto;background:#ffffffee;-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);display:flex;justify-content:space-between;align-items:center;padding:14px 26px 24px;color:#e5a50a}
.hi{position:absolute;bottom:8px;left:50%;transform:translateX(-50%);width:134px;height:5px;border-radius:3px;background:#000;z-index:6;pointer-events:none}
@media(max-width:430px){.hi{display:none}}

html,body{overflow:hidden;overscroll-behavior:none;-webkit-tap-highlight-color:transparent;-webkit-touch-callout:none;touch-action:manipulation}
#app{position:fixed!important;top:0;bottom:0;left:0;right:0;margin:0 auto;height:auto!important}
.pg{padding-top:max(22px,calc(env(safe-area-inset-top,0px) + 10px));padding-bottom:max(22px,env(safe-area-inset-bottom,0px))}
.ntop{padding-top:max(24px,calc(env(safe-area-inset-top,0px) + 8px))}
.fb{padding-bottom:max(22px,calc(env(safe-area-inset-bottom,0px) + 4px))}
.nb{padding-bottom:max(24px,calc(env(safe-area-inset-bottom,0px) + 6px))}
@media(min-width:440px){html,body{background:#000!important}}
.ed{position:absolute;inset:0;display:flex;flex-direction:column;background:#fff;color:#000;font-family:-apple-system,"SF Pro Text","InterE","Inter","Helvetica Neue",Arial,sans-serif;-webkit-font-smoothing:antialiased;letter-spacing:-.011em}
.ed .ntop{position:static;flex:none}
.ed .rt{gap:20px;align-items:center;min-height:30px;padding-left:20px}.ed .rt svg:first-child{width:24px;height:24px}
.ok{font-weight:700;font-size:17px;color:#e5a50a;cursor:pointer}
.tx{flex:1;overflow-y:auto;padding:0 0 12px}
.ln{padding:0 24px;min-height:25px;font-size:17px;line-height:25px;color:#3c3c3e;white-space:pre-wrap;word-break:break-word}
.ln.t{font-size:32px;line-height:38px;font-weight:700;color:#3d3d3f;margin:14px 0 6px;min-height:38px}
.cr{display:inline-block;width:2px;height:1.15em;background:#e5a50a;vertical-align:text-bottom;margin-left:1px;animation:bl 1s steps(2,jump-none) infinite}
@keyframes bl{50%{opacity:0}}
#kbw{flex:none;background:#d1d4d9;padding-bottom:env(safe-area-inset-bottom,0px)}
.tb{display:flex;justify-content:space-around;align-items:center;height:44px;background:#f7f7f9;border-top:.5px solid #c8c9ce;color:#000}
.qt{display:flex;height:42px;background:#d1d4d9}.qt span{flex:1;text-align:center;line-height:42px;font-size:16px;color:#000;border-right:.5px solid #b7bac1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding:0 6px}.qt span:last-child{border:0}
.kb{padding:6px 3px 0}.kr{display:flex;gap:6px;margin-bottom:11px;align-items:center}
.k{flex:1;min-width:0;height:42px;border:0;border-radius:5px;background:#fff;box-shadow:0 1px 0 #898a8d;font:400 22px -apple-system,"SF Pro Text","InterE",sans-serif;color:#000;padding:0;display:flex;align-items:center;justify-content:center;-webkit-user-select:none;user-select:none}
.k:active{background:#acb3bd}.k.s{background:#acb3bd;font-size:16px}.k.s:active{background:#fff}
.k.w{flex:1.45}.k.w2{flex:1.3}.k.w3{flex:1.9}.k.sp{flex:5;font-size:16px}.g{flex:.35}
.bi{display:flex;justify-content:space-between;align-items:center;padding:2px 20px 6px;height:40px}
#pk{position:fixed;top:max(14px,calc(env(safe-area-inset-top,0px) + 6px));left:50%;transform:translateX(-50%);z-index:60;background:rgba(20,20,22,.84);color:#fff;font:600 20px -apple-system,"InterE",sans-serif;padding:9px 20px;border-radius:24px;pointer-events:none}
.big{-webkit-user-select:none;user-select:none}
.opt{display:flex;align-items:center;gap:10px;font-size:14px;margin:0 0 12px}.opt input{width:20px;height:20px}
#ce{position:fixed;top:0;left:0;width:2px;height:2px;opacity:0;overflow:hidden;font-size:16px;white-space:pre-wrap;caret-color:transparent;-webkit-user-select:text;user-select:text;outline:none;z-index:-1;pointer-events:none}
.tbn{position:absolute;left:0;right:0;bottom:var(--kb,0px);z-index:5}
.ed.nat .tx{margin-bottom:calc(var(--kb,0px) + 44px)}
.stp{display:flex;align-items:center;gap:18px;margin:0 0 14px}.stp button{width:46px;height:46px;border-radius:50%;border:0;background:var(--gold);color:#1c1c1e;font:700 24px sans-serif}.stp b{font-size:26px;min-width:36px;text-align:center}
</style></head>
<body><div id="app"></div><div id="ce" contenteditable="true" autocapitalize="sentences" autocorrect="off" spellcheck="false" autocomplete="off" role="textbox" aria-hidden="true"></div>
<script>
const $=s=>document.querySelector(s),esc=t=>String(t).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const sv=(w,h,b,x="")=>`<svg width="${w}" height="${h}" viewBox="0 0 ${w} ${h}" ${x} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${b}</svg>`;
const ic={chev:sv(12,20,'<path d="M10 2L2 10l8 8"/>','stroke-width="2.6"'),
share:sv(22,26,'<path d="M11 16V2M6 6l5-5 5 5M4 10H3a1 1 0 00-1 1v12a1 1 0 001 1h16a1 1 0 001-1V11a1 1 0 00-1-1h-1"/>'),
more:sv(28,28,'<circle cx="14" cy="14" r="12"/><circle cx="8.5" cy="14" r="1.2" fill="currentColor"/><circle cx="14" cy="14" r="1.2" fill="currentColor"/><circle cx="19.5" cy="14" r="1.2" fill="currentColor"/>'),
check:sv(30,26,'<circle cx="6" cy="6" r="4.5" fill="currentColor"/><circle cx="6" cy="20" r="4.5"/><path d="M14 6h14M14 20h14"/>'),
cam:sv(30,26,'<path d="M3 7h5l2-3h10l2 3h5a1 1 0 011 1v14a1 1 0 01-1 1H3a1 1 0 01-1-1V8a1 1 0 011-1z"/><circle cx="15" cy="15" r="5.5"/>'),
pen:sv(30,30,'<circle cx="15" cy="15" r="13"/><path d="M15 6l4 12v4h-8v-4zM11 18h8"/>'),
compose:sv(28,28,'<path d="M12 4H6a3 3 0 00-3 3v15a3 3 0 003 3h15a3 3 0 003-3v-6"/><path d="M22 3l3 3-11 11-4 1 1-4z"/>'),
search:sv(20,20,'<circle cx="8.5" cy="8.5" r="6.5"/><path d="M13.5 13.5L18 18"/>','stroke-width="2.2"'),
mic:sv(16,22,'<rect x="4.5" y="1" width="7" height="12" rx="3.5"/><path d="M1.5 10a6.5 6.5 0 0013 0M8 17v4"/>'),
fold:sv(30,24,'<path d="M2 5a3 3 0 013-3h6l3 3h11a3 3 0 013 3v12a3 3 0 01-3 3H5a3 3 0 01-3-3z"/><path d="M2 9h26"/>','stroke="#f0a800"'),
foldp:sv(34,28,'<path d="M3 6a3 3 0 013-3h6l3 3h10a3 3 0 013 3v12a3 3 0 01-3 3H6a3 3 0 01-3-3z"/><path d="M26 11v8M22 15h8"/>'),
gear:sv(30,26,'<circle cx="15" cy="13" r="4"/><circle cx="15" cy="13" r="10" stroke-dasharray="4 3.3"/>','stroke="#f0a800"'),
cr:sv(8,14,'<path d="M1 1l6 6-6 6"/>','stroke="#c4c4c7" stroke-width="2.2"'),
dn:sv(14,8,'<path d="M1 1l6 6 6-6"/>','stroke="#8e8e93" stroke-width="2.2"'),
mini:sv(13,11,'<path d="M1 2a1 1 0 011-1h3l1.500 1.500H11a1 1 0 011 1V9a1 1 0 01-1 1H2a1 1 0 01-1-1z"/>','stroke="#8e8e93" stroke-width="1.3"')};

const SH=s=>`<svg width="22" height="22" viewBox="0 0 22 22"><path d="M11 3L2.5 12H7v6h8v-6h4.5z" fill="${s?"#000":"none"}" stroke="#000" stroke-width="1.6" stroke-linejoin="round"/>${s===2?'<path d="M7 20.5h8" stroke="#000" stroke-width="1.8"/>':""}</svg>`;
const DELS='<svg width="26" height="20" viewBox="0 0 26 20" fill="none" stroke="#000" stroke-width="1.6" stroke-linejoin="round"><path d="M8 1.5h15a2 2 0 012 2v13a2 2 0 01-2 2H8L1.5 10z"/><path d="M12 6.5l7 7M19 6.5l-7 7"/></svg>';
const SMI='<svg width="26" height="26" viewBox="0 0 26 26" fill="none" stroke="#000" stroke-width="1.6" stroke-linecap="round"><circle cx="13" cy="13" r="11.5"/><circle cx="9.5" cy="10.5" r="1" fill="#000"/><circle cx="16.5" cy="10.5" r="1" fill="#000"/><path d="M7.5 15.5c1.5 3.5 9.5 3.5 11 0"/></svg>';
const TBL='<svg width="26" height="22" viewBox="0 0 26 22" fill="none" stroke="#000" stroke-width="1.6"><rect x="1.5" y="1.5" width="23" height="19" rx="3"/><path d="M1.5 8h23M1.5 14h23M9 1.5v19M17 1.5v19"/></svg>';
const CHK='<svg width="26" height="26" viewBox="0 0 26 26" fill="none" stroke="#000" stroke-width="1.6" stroke-linecap="round"><circle cx="13" cy="13" r="11.5"/><path d="M7.5 13.5l4 4 7-8"/></svg>';
const XX='<svg width="22" height="22" viewBox="0 0 22 22" stroke="#b6b7bd" stroke-width="2" stroke-linecap="round"><path d="M4 4l14 14M18 4L4 18"/></svg>';
const DEF={on:true,line:2,sim:1,first:true,kbm:"real"};
let S={cfg:Object.assign({},DEF),notes:[]};
try{const j=JSON.parse(localStorage.getItem("dfb2"));if(j){S.notes=j.notes||[];S.cfg=Object.assign({},DEF,j.cfg)}}catch(e){}
const save=()=>{try{localStorage.setItem("dfb2",JSON.stringify(S))}catch(e){}};
let V="list",cur=null,kb=true,num=false,sh=1,lastSh=0,rep=null,LT=null,TT=null,LPF=false;

/* palabra falsa: mismas letras en número, errores típicos de escribir a ciegas (teclas vecinas) */
const NB={q:"wa",w:"qes",e:"wrd",r:"etf",t:"ryg",y:"tuh",u:"yij",i:"uok",o:"ipl",p:"oñ",a:"qsz",s:"awdx",d:"sefc",f:"drgv",g:"fthb",h:"gyjn",j:"hukm",k:"jil",l:"kop",ñ:"lp",z:"asx",x:"zsdc",c:"xdfv",v:"cfgb",b:"vghn",n:"bhjm",m:"njk"};
const rnd=(a,b)=>{const x=Math.sin(a*9301+b*49297+7)*233280;return x-Math.floor(x)};
function fakeCh(ch,seed,j){
 const lo=ch.toLowerCase(),up=ch!==lo;if(!/[a-zñ]/.test(lo))return ch;
 const r=rnd(seed,j),r2=rnd(seed,j+500),sim=[.12,.3,.5][S.cfg.sim];let o;
 if(j===0&&S.cfg.first&&r<.85)o=lo;
 else if(r<sim)o=lo;
 else if("aeiou".includes(lo))o="aeiou"[Math.floor(r2*5)];
 else{const n=NB[lo]||"asd";o=n[Math.floor(r2*n.length)]}
 return up?o.toUpperCase():o}
function disp(n,i){const r=n.real[i]||"";if(!(S.cfg.on&&i===n.sl))return r;
 const a=Array.from(r).map((c,j)=>fakeCh(c,n.seed,j));let o=a.join("");
 if(o===r&&a.length>1){for(let j=a.length-1;j>0;j--){const lo=a[j].toLowerCase();if(NB[lo]){const t=NB[lo][0];a[j]=a[j]===lo?t:t.toUpperCase();break}}o=a.join("")}
 return o}

/* vistas */
const DEC=["Top 100 películas|El Padrino, Cadena perpetua…|Ayer|Ayer","Bebidas|Heineken, Captain Morgan…|Ayer|Ayer","Libros pendientes|El guardián entre el centeno, 1984…|Martes|Últimos 7 días","Por hacer|Comprar pan|Lunes|Últimos 7 días","Ideas de regalo|Mirar ofertas a principios de mes|Domingo|Últimos 7 días","Recetas para la cena|Tortilla de patatas, ensalada…|Sábado|Últimos 7 días","Viaje a Madrid|Vuelo 7:45, hotel cerca de Atocha|3/11/26|Últimos 30 días","Presupuesto mensual|Alquiler, luz, internet…|1/11/26|Últimos 30 días","Teléfonos útiles|Fontanero, cerrajero, dentista…|29/10/26|Últimos 30 días","Playlist del coche|Queen, Estopa, Coldplay…|24/10/26|Últimos 30 días","Cumpleaños de mamá|Reservar mesa para el sábado|12/10/26|Anteriores","Series pendientes|Dark, The Bear, Succession|2/10/26|Anteriores"];
const hm=t=>{const d=new Date(t);return d.getHours()+":"+String(d.getMinutes()).padStart(2,"0")};
const row=(t,p,d,oc)=>`<div class="nr" ${oc?`onclick="${oc}"`:""}><b>${esc(t)}</b><small><em>${d}</em>${esc(p)}</small></div>`;
function listV(){
 const mine=S.notes.slice().reverse().map(n=>row(n.real[0]||"Nueva nota",n.real.length>1?disp(n,1)||"Sin texto adicional":"Sin texto adicional",hm(n.ts),"openN("+n.id+")")).join("");
 let h=mine?`<div class="sec">Hoy</div><div class="grp">${mine}</div>`:"";
 ["Ayer","Últimos 7 días","Últimos 30 días","Anteriores"].forEach(s=>{const g=DEC.filter(d=>d.split("|")[3]===s).map(d=>{const[t,p,dt]=d.split("|");return row(t,p,dt)}).join("");h+=`<div class="sec">${s}</div><div class="grp">${g}</div>`});
 return `<div class="notes"><div class="ntop g"><button class="gl">${ic.chev}</button><span class="rt"><button class="gl">${ic.more}</button></span></div><div class="big" onpointerdown="tS()" onpointerup="tE()" onpointerleave="tE()" oncontextmenu="return false">Notas</div>${h}<div style="height:16px;flex:none"></div><div class="fb"><div class="sp">${ic.search}<span>Buscar</span>${ic.mic}</div><button class="cp" onclick="newNote()">${ic.compose}</button></div></div>`}
const LP='onpointerdown="lpS()" onpointerup="lpE()" onpointercancel="lpE()" onpointerleave="lpE()" oncontextmenu="return false"';
function kbW(){return `<div id="kbw"><div class="tb">${TBL}<span style="font-size:22px">A<small style="font-size:16px">a</small></span>${CHK}${ic.cam}${ic.pen}${XX}</div><div class="qt" id="qt"></div><div class="kb" id="kb">${keys()}</div><div class="bi">${SMI}${ic.mic}</div></div>`}
function editV(){const own=S.cfg.kbm==="own",nat=kb&&!own;
 const tb=`<div class="tb${own?"":" tbn"}">${TBL}<span style="font-size:22px">A<small style="font-size:16px">a</small></span>${CHK}${ic.cam}${ic.pen}${XX}</div>`;
 return `<div class="ed${nat?" nat":""}"><div class="ntop"><button class="bk" onclick="back()">${ic.chev}<span>Notas</span></button><span class="rt" ${LP}>${kb?`${ic.more}<b class="ok" onclick="done()">OK</b>`:`${ic.share}${ic.more}`}</span></div><div class="tx" id="tx" ${kb?"":'onclick="edit()"'}></div>${kb?(own?kbW():tb):`<div class="nb">${ic.check}${ic.cam}${ic.pen}<span onclick="newNote()">${ic.compose}</span></div>`}</div>`}
function setV(){const c=S.cfg;return `<div class="pg"><div class="top"><button class="back" onclick="V='list';R()">‹</button><b>Ajustes</b></div>
<h2>Truco</h2><label class="opt"><input type="checkbox" ${c.on?"checked":""} onchange="S.cfg.on=this.checked;save()"> Modo truco activado</label>
<p>Fila en la que escribe el espectador (1 a 10)</p><div class="stp"><button onclick="stepL(-1)">−</button><b id="lv">${c.line}</b><button onclick="stepL(1)">+</button></div>
<p>Teclado</p><select onchange="S.cfg.kbm=this.value;save()"><option value="real" ${c.kbm!=="own"?"selected":""}>El del iPhone (recomendado)</option><option value="own" ${c.kbm==="own"?"selected":""}>Propio, imitado (por si el real muestra sugerencias)</option></select>
<p>Parecido de la palabra falsa</p><select onchange="S.cfg.sim=+this.value;save()">${["Bajo","Medio","Alto"].map((t,i)=>`<option value="${i}" ${i==c.sim?"selected":""}>${t}</option>`).join("")}</select>
<label class="opt"><input type="checkbox" ${c.first?"checked":""} onchange="S.cfg.first=this.checked;save()"> Mantener casi siempre la primera letra</label>
<h2>Datos</h2><button class="btn s" onclick="if(confirm('¿Borrar todas las notas creadas?')){S.notes=[];save();V='list';R()}">Borrar mis notas</button>
<button class="btn s" onclick="V='ins';R()">Instrucciones</button>
<p style="font-size:12px;color:var(--mut);text-align:center">Esta versión ha sido creada por Telmo.</p></div>`}
function insV(){return `<div class="pg"><div class="top"><button class="back" onclick="V='set';R()">‹</button><b>Instrucciones</b></div>
<h2>La rutina</h2><p>1. Abre Notas y pulsa el botón de redactar (abajo a la derecha). Se abre una nota nueva y el teclado del iPhone aparece solo.</p>
<p>2. Di que vas a intentar escribir una palabra a ciegas. Cierra los ojos y escríbela en la primera línea (sale como salga). Pulsa <b>intro</b>.</p>
<p>3. En la segunda línea, el espectador escribe con los ojos cerrados la palabra que ha pensado. Tú no miras.</p>
<p>4. Antes de abrir los ojos, que diga si cree que la ha escrito bien o mal. Al abrirlos verá una palabra mal escrita, con las mismas letras que la suya pero con fallos de teclas vecinas. Es la tapadera: la verdadera nunca se ve.</p>
<p>5. Si quieres, pulsa <b>intro</b> y haz otra demostración tú en la tercera línea: la del espectador se queda como está.</p>
<h2>Ver la palabra verdadera</h2><p>Mantén pulsado medio segundo, <b>arriba a la derecha</b> (sobre “OK” o “⋯”), y aparece la palabra real en una burbuja arriba. Al soltar desaparece.</p>
<h2>Menú secreto</h2><p>En la lista, mantén pulsado el título “Notas” casi un segundo. Ahí eliges con + y − en qué fila escribe el espectador (1 a 10). El cambio vale para las notas nuevas.</p><h2>Si el teclado muestra sugerencias</h2><p>En el menú secreto puedes cambiar a “Propio, imitado”, que nunca muestra la palabra real.</p></div>`}
function bgc(){return V==="list"?"#f2f2f7":V==="edit"?(kb&&S.cfg.kbm==="own"?"#d1d4d9":"#fff"):"#f3efe6"}
function stepL(d){S.cfg.line=Math.min(10,Math.max(1,S.cfg.line+d));save();$("#lv").textContent=S.cfg.line}
function setBG(c){const r=document.documentElement,b=document.body;r.style.backgroundColor=c;b.style.backgroundColor=c;const m=document.querySelector('meta[name="theme-color"]');if(m)m.content=c}
function R(){$("#app").innerHTML=V==="list"?listV():V==="edit"?editV():V==="set"?setV():insV();
 const nat=V==="edit"&&kb&&S.cfg.kbm!=="own";
 if(nat){try{ce.focus({preventScroll:true})}catch(e){ce.focus()}syncCE()}else ce.blur();
 if(V==="edit")upd();setBG(bgc());kbH()}
/* campo oculto que recibe el teclado real: yo guardo lo que se teclea y dibujo la versión falsa */
const ce=$("#ce");
function syncCE(){if(!cur)return;ce.textContent=cur.real.join("\n");const r=document.createRange(),g=getSelection();r.selectNodeContents(ce);r.collapse(false);g.removeAllRanges();g.addRange(r)}
function delBack(w){const r=cur.real,i=r.length-1;if(!r[i].length){if(i>0)r.pop();return}const a=Array.from(r[i]);if(w){while(a.length&&a[a.length-1]===" ")a.pop();while(a.length&&a[a.length-1]!==" ")a.pop()}else a.pop();r[i]=a.join("")}
ce.addEventListener("beforeinput",e=>{
 e.preventDefault();if(V!=="edit"||!cur||!kb)return;
 const t=e.inputType,r=cur.real,i=r.length-1;
 if(t==="insertText"){r[i]+=(e.data||"").replace(/[\r\n]/g,"")}
 else if(t==="insertParagraph"||t==="insertLineBreak"){r.push("")}
 else if(t==="deleteContentBackward"||t==="deleteSoftLineBackward"||t==="deleteHardLineBackward"){delBack(false)}
 else if(t==="deleteWordBackward"){delBack(true)}
 else return;
 save();syncCE();upd()});
const kbH=()=>{const v=window.visualViewport,h=v?Math.max(0,Math.round(innerHeight-v.height-v.offsetTop)):0;document.documentElement.style.setProperty("--kb",(S.cfg.kbm==="own"?0:h)+"px")};
if(window.visualViewport){visualViewport.addEventListener("resize",kbH);visualViewport.addEventListener("scroll",kbH)}


/* teclado */
function keys(){
 const L=[["q","w","e","r","t","y","u","i","o","p"],["a","s","d","f","g","h","j","k","l","ñ"],["z","x","c","v","b","n","m"]];
 const N=[["1","2","3","4","5","6","7","8","9","0"],["-","/",":",";","(",")","€","&","@",'"'],[".",",","?","!","'"]];
 const Rw=num?N:L,up=!num&&sh>0;
 const k=c=>`<button class="k" data-k="${c==='"'?"&quot;":c}">${up?c.toUpperCase():c}</button>`;
 const r3=(num?`<button class="k s w" data-k="SYM">#+=</button>`:`<button class="k s w" data-k="SHIFT">${SH(sh)}</button>`)+'<div class="g"></div>'+Rw[2].map(k).join("")+'<div class="g"></div>'+`<button class="k s w" data-k="DEL">${DELS}</button>`;
 const r4=`<button class="k s w2" data-k="${num?"ABC":"NUM"}">${num?"ABC":"123"}</button><button class="k sp" data-k="SPACE">espacio</button><button class="k s w3" data-k="ENTER">intro</button>`;
 return `<div class="kr">${Rw[0].map(k).join("")}</div><div class="kr">${Rw[1].map(k).join("")}</div><div class="kr">${r3}</div><div class="kr">${r4}</div>`}
const kbRe=()=>{const e=$("#kb");if(e)e.innerHTML=keys()};
function press(k){const n=cur;if(!n)return;const r=n.real,i=r.length-1,sig=num+""+sh;
 if(k==="SHIFT"){const t=Date.now();sh=(t-lastSh<320)?2:(sh?0:1);lastSh=t;kbRe();return}
 if(k==="NUM"||k==="ABC"){num=k==="NUM";kbRe();return}
 if(k==="SYM"||k==="EMO")return;
 if(k==="DEL"){if(!r[i].length&&i>0)r.pop();else r[i]=Array.from(r[i]).slice(0,-1).join("");if(!r[r.length-1].length)sh=1}
 else if(k==="ENTER"){r.push("");sh=1}
 else if(k==="SPACE"){r[i]+=" "}
 else{r[i]+=(!num&&sh>0)?k.toUpperCase():k;if(sh===1)sh=0}
 save();if(sig!==num+""+sh)kbRe();upd()}
document.addEventListener("pointerdown",e=>{const b=e.target.closest&&e.target.closest(".k");if(!b)return;e.preventDefault();const k=b.dataset.k;press(k);clearTimeout(rep);if(k==="DEL")rep=setTimeout(function f(){press("DEL");rep=setTimeout(f,70)},420)},{passive:false});
["pointerup","pointercancel"].forEach(t=>document.addEventListener(t,()=>clearTimeout(rep)));

/* texto de la nota */
function upd(){const n=cur,tx=$("#tx");if(!tx||!n)return;
 tx.innerHTML=n.real.map((_,i)=>`<div class="ln${i?"":" t"}">${esc(disp(n,i))||"&#8203;"}${kb&&i===n.real.length-1?'<i class="cr"></i>':""}</div>`).join("");
 tx.scrollTop=tx.scrollHeight;
 const q=$("#qt");if(q){const d=disp(n,n.real.length-1),w=d.split(/\s+/).pop();q.innerHTML=`<span>${w&&!/\s$/.test(d)?"“"+esc(w)+"”":""}</span><span></span><span></span>`}}
function newNote(){const n={id:Date.now(),ts:Date.now(),real:[""],sl:S.cfg.line-1,seed:Math.floor(Math.random()*1e6)};S.notes.push(n);save();cur=n;V="edit";kb=true;num=false;sh=1;R()}
function openN(id){cur=S.notes.find(n=>n.id===id);if(!cur)return;V="edit";kb=false;R()}
function back(){ce.blur();if(cur&&cur.real.every(x=>!x))S.notes=S.notes.filter(x=>x!==cur);save();cur=null;V="list";R()}
function done(){if(LPF){LPF=false;return}ce.blur();kb=false;R()}
function edit(){kb=true;num=false;sh=1;R()}

/* gestos secretos */
function pk(w){let p=$("#pk");if(w==null){if(p)p.remove();return}if(!p){p=document.createElement("div");p.id="pk";document.body.appendChild(p)}p.textContent=w}
function lpS(){LPF=false;clearTimeout(LT);LT=setTimeout(()=>{LPF=true;const n=cur;pk(n&&S.cfg.on?(n.real[n.sl]||"—"):"—")},550)}
function lpE(){clearTimeout(LT);pk(null)}
function tS(){clearTimeout(TT);TT=setTimeout(()=>{V="set";R()},850)}
function tE(){clearTimeout(TT)}
R();
</script></body></html>
